# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Supabase (Project Settings → Database → URI)
DATABASE_URL=

# Local Redis from docker-compose (use redis://redis:6379/0 inside Compose)
REDIS_URL=

# "assemblyai" or "deepgram"
TRANSCRIPTION_PROVIDER=

# https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Frontend (copy these into frontend/.env.local as well)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
